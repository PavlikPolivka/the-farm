{
  "name": "pixel-farm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./server --filter ./client dev",
    "build": "pnpm assets && pnpm -r build",
    "vapid": "tsx scripts/gen-vapid.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "assets": "tsx scripts/assets/build.ts",
    "assets:download": "tsx scripts/assets/download.ts",
    "balance": "tsx scripts/balance-sim.ts",
    "e2e": "playwright test",
    "size": "tsx scripts/size-budget.ts"
  },
  "devDependencies": {
    "@pixel-farm/shared": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "web-push": "^3.6.7"
  }
}
