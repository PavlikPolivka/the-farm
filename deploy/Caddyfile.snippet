# Appended to /opt/caddy/Caddyfile by homelab-setup.sh. Same port-per-app pattern as the
# other services; the Cloudflare tunnel maps farm.ppolivka.com -> http://caddy:9097.
# No forward_auth: the app does its own OIDC login against Authelia.
:9097 {
	encode zstd gzip
	reverse_proxy pixel-farm:3000
}
