# Copy to /opt/pixel-farm/.env and fill in. Never commit the real file.
PUBLIC_URL=https://farm.ppolivka.com

# 32+ random characters:  openssl rand -base64 48
SESSION_SECRET=

# Authelia OIDC client (see authelia-client.yml)
OIDC_ISSUER=https://auth.ppolivka.com
OIDC_CLIENT_ID=pixel-farm
# The plain-text secret; Authelia stores only its hash.
OIDC_CLIENT_SECRET=

# Web Push keys:  pnpm vapid   (or: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:polivka.pavel@gmail.com

# Local dev only (ignored when NODE_ENV=production): act as this user without logging in.
# DEV_FAKE_USER=pavel
